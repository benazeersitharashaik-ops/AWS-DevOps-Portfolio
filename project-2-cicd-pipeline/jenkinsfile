 pipeline {
    agent any

    stages {

        stage('SCM checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/benazeersitharashaik-ops/sample1-public.git'
            }
        }

        stage('Archiving Artifacts') {
            steps {
                archiveArtifacts artifacts: '**/*.*'
            }
        }

        stage('Deployment') {
            steps {
                sshPublisher(
                    publishers: [
                        sshPublisherDesc(
                            configName: 'website',
                            transfers: [
                                sshTransfer(
                                    sourceFiles: '**/*.*',
                                    removePrefix: '',
                                    remoteDirectory: 'www/html',
                                    flatten: false,
                                    cleanRemote: false,
                                    makeEmptyDirs: false,
                                    noDefaultExcludes: false,
                                    patternSeparator: '[, ]+',
                                    execCommand: '',
                                    execTimeout: 120000
                                )
                            ],
                            usePromotionTimestamp: false,
                            useWorkspaceInPromotion: false,
                            verbose: true
                        )
                    ]
                )
            }
        }
    }
}
