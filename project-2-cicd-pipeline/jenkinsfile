pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t my-cicd-website:latest .'
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                docker rm -f my-cicd-container || true
                docker run -d --name my-cicd-container -p 8080:80 my-cicd-website:latest
                '''
            }
        }
    }
}
